{
  "name": "ttwar",
  "version": "3.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.12.0", "npm": ">=11.21.2 <12" },
  "packageManager": "npm@11.21.2",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start": "npm start -w backend",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "lint": "eslint frontend/src backend scripts && node scripts/check-structure.cjs",
    "test": "npm test -w backend",
    "test:journey": "node --test backend/tests/recruitment-journey.test.cjs",
    "check:executor": "node scripts/check-executor.cjs",
    "check:email": "node scripts/check-email.cjs",
    "check:health": "node scripts/check-health.cjs",
    "backup:init": "node scripts/database-backup.cjs init-key",
    "backup:create": "node scripts/database-backup.cjs create",
    "backup:verify": "node scripts/database-backup.cjs verify",
    "test:backup": "node --test --test-concurrency=1 scripts/tests/database-backup.integration.cjs",
    "check:deps": "node scripts/check-dependencies.cjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "check": "npm run check:deps && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.58.2"
  },
  "overrides": {
    "swagger-jsdoc@6.3.0": { "glob": { ".": "14.0.2", "minimatch": "11.0.1" } },
    "@typescript-eslint/typescript-estree@8.72.2": { "minimatch": "11.0.1" }
  }
}
