{
  "name": "ttwar-backend-unified",
  "version": "2.0.0",
  "description": "سيرفر منصة تطور الموحد — جميع الصفحات في سيرفر واحد",
  "main": "server.js",
  "scripts": {
    "start":      "node server.js",
    "dev":        "nodemon server.js",
    "seed":       "node config/seed.js",
    "seed:fresh": "node config/seed.js --fresh",
    "test":       "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand"
  },
  "dependencies": {
    "bcryptjs":           "^2.4.3",
    "cors":               "^2.8.5",
    "dotenv":             "^16.3.1",
    "express":            "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "joi":                "^17.11.0",
    "jsonwebtoken":       "^9.0.2",
    "mongoose":           "^8.0.0",
    "morgan":             "^1.10.0",
    "node-fetch":         "^2.7.0",
    "swagger-jsdoc":      "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "jest":      "^29.7.0",
    "nodemon":   "^3.0.2",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch":       ["**/tests/**/*.test.js"],
    "testTimeout":     30000
  }
}
